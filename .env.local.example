# Copy this file to .env.local and fill in real values to enable a TURN relay
# for online play (see js/online.js). Without .env.local, the game falls back
# to pure P2P (STUN only) -- most connections still work, but two peers who
# can't find a direct path (eg. both behind symmetric NAT) won't be able to
# connect to each other.
#
# TURN_URL should include the scheme and port, eg. turn:free.expressturn.com:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
